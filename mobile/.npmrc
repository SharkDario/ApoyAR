# Configuración requerida para compatibilidad de Metro bundler con pnpm.
#
# node-linker=hoisted  → los paquetes se instalan como directorios reales
#                         en node_modules/ (no como symlinks). Metro no
#                         atraviesa symlinks correctamente.
#
# shamefully-hoist=true → TODOS los paquetes transitivos (babel-preset-expo,
#                          metro internals, etc.) se elevan al root node_modules/,
#                          no solo las dependencias directas.
#
# Ambas opciones son necesarias juntas.
node-linker=hoisted
shamefully-hoist=true