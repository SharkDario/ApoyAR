# mobile/.env.example — Plantilla de Variables de Entorno del Cliente Móvil (ApoyAR)
# Copiá este archivo como .env y completá con los valores de tu entorno.

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL de tu proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Anon Public Key (segura para exponer en cliente móvil, respeta RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Backend FastAPI ───────────────────────────────────────────────────────────
# Dirección IP local de tu computadora en la red Wi-Fi (puerto 8000).
# IMPORTANTE: En celulares físicos no usar 'localhost', usar la IP de tu PC (ej. http://192.168.1.25:8000).
EXPO_PUBLIC_API_BASE_URL=http://TU_IP_LOCAL:8000

# Clave secreta compartida con el backend para validación de requests
EXPO_PUBLIC_API_SECRET_KEY=CLAVE_SECRETA_COMPARTIDA_HEX

# ── MapTiler (Mapas Vectoriales MapLibre) ──────────────────────────────────────
# API Key gratuita obtenible en https://cloud.maptiler.com/
EXPO_PUBLIC_MAPTILER_API_KEY=TU_MAPTILER_API_KEY

# Clave pública de custodia (SPKI DER en Base64), par de DEK_CUSTODIA_PRIVATE_KEY_B64 del backend
EXPO_PUBLIC_DEK_CUSTODIA_PUBLIC_KEY=
