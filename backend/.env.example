# .env.example — Copiá este archivo como .env y completá los valores reales.
# NUNCA commitear el .env con valores reales.

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL del proyecto Supabase (ej: https://abcdefgh.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clave anon/public — segura para uso en cliente (respeta RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role — SOLO para el backend (bypass de RLS). NUNCA al frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── FastAPI ───────────────────────────────────────────────────────────────────
# Secreto para validar que los pedidos al backend vienen de la app autorizada.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=REPLACE_WITH_RANDOM_HEX_64_CHARS

# Puerto del servidor (default: 8000)
PORT=8000

# ── Sellado de Tiempo RFC 3161 (TSA - Time Stamping Authority) ─────────────────
# URL del servidor Time Stamp Protocol (IETF RFC 3161).
# Por defecto se utiliza FreeTSA (servicio público gratuito y neutral):
#   Endpoint: https://freetsa.org/tsr
#   No requiere registro ni API Key.
# Otras alternativas comerciales/institucionales:
#   - DigiCert: http://timestamp.digicert.com
#   - Sectigo: http://timestamp.sectigo.com
#   - AC Raíz de la República Argentina (Ley 25.506) para entornos judiciales oficiales.
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT_SECONDS=5.0
